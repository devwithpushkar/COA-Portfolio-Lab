# ---------------------------------------------------------------------------
# Backend environment configuration (FastAPI).
# Copy to `.env` for local experimentation, or set these in the Render dashboard.
# NEVER commit real secrets. This file documents the KEYS only.
# ---------------------------------------------------------------------------

# PostgreSQL connection string in production. Render injects this automatically
# when you attach a PostgreSQL database. Leave UNSET for local development to
# fall back to a SQLite file at server/assignments.db.
# Both postgres:// and postgresql:// forms are accepted (mapped to psycopg v3).
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Token required (via X-Admin-Token header) for create/update/delete.
# Reads are always public. Set a strong random value in production.
# If unset, a local development default is used.
COA_ADMIN_TOKEN=change-me-to-a-strong-random-value

# Comma-separated list of allowed browser origins for CORS.
# In production set this to your deployed frontend URL.
# If unset, local dev origins (localhost:5173 / 127.0.0.1:5173) are allowed.
# FRONTEND_ORIGIN=https://your-frontend.onrender.com
